{
  "enabled": true,
  "name": "Smart MCP Enable with Tool Scoping",
  "description": "Analyzes user prompts to detect which specific MCP_DOCKER tool categories are needed. Enables MCP_DOCKER and writes the allowed tool categories to a temp file so the preToolUse gatekeeper can block unrelated tools.",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "IMPORTANT: Before proceeding with the user's request, analyze the prompt to determine if it requires MCP server tools from MCP_DOCKER.\n\nRead `.kiro/steering/mcp-tools-reference.md` for the complete tool-to-category mapping.\n\nSTEPS:\n1. Determine which CATEGORIES the user's prompt needs. If none needed, proceed normally.\n2. If MCP tools are needed, read ~/.kiro/settings/mcp.json. If MCP_DOCKER has disabled:true, set it to false and write back.\n3. Write the allowed categories to /tmp/kiro_mcp_allowed_categories.txt (one category per line, e.g. GITHUB). This file will be read by the preToolUse gatekeeper hook.\n4. Proceed with the user's request."
  }
}
