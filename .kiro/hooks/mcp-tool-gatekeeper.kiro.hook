{
  "enabled": true,
  "name": "MCP Tool Gatekeeper",
  "description": "Gatekeeper that blocks MCP_DOCKER tools not relevant to the current prompt. Reads allowed categories from /tmp/kiro_mcp_allowed_categories.txt and blocks tools outside those categories.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "@mcp.*MCP_DOCKER.*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "An MCP_DOCKER tool is about to be invoked. Before allowing it, check if this specific tool is permitted for the current task.\n\nRead `/tmp/kiro_mcp_allowed_categories.txt` to see which categories are allowed. Then read `.kiro/steering/mcp-tools-reference.md` for the complete category-to-tool mapping to determine if the tool being invoked belongs to one of the allowed categories.\n\nIf the tool belongs to an allowed category: respond with ACCESS GRANTED, proceed with the tool call.\nIf the tool does NOT belong to any allowed category: respond with ACCESS DENIED - this tool is not needed for the current task. Do not invoke this tool.\nIf /tmp/kiro_mcp_allowed_categories.txt does not exist: respond with ACCESS GRANTED (no restrictions in place)."
  }
}
